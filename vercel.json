{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/thue/chinh-sach-bao-mat", "destination": "/thue/chinh-sach-bao-mat.html" },
    { "source": "/thue/dieu-khoan-su-dung", "destination": "/thue/dieu-khoan-su-dung.html" },
    { "source": "/thue/xoa-du-lieu", "destination": "/thue/xoa-du-lieu.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/convert/pdf-to-docx.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/convert/pdf-to-docx",
      "methods": ["POST", "OPTIONS"],
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    }
  ]
}
